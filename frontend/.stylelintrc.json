{
  "extends": "stylelint-config-standard",
  "rules": {
    "color-no-hex": true,
    "selector-pseudo-element-no-unknown": [
      true,
      {
        "ignorePseudoElements": [
          "ng-deep"
        ]
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "plugin",
          "theme",
          "utility",
          "variant",
          "custom-variant",
          "apply",
          "source"
        ]
      }
    ]
  },
  "ignoreFiles": [
    "src/styles.css"
  ]
}
