{
  "name": "frontend",
  "version": "0.5.7",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --configuration coverage",
    "test:browser": "ng run frontend:test-browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "help:diagrams": "bun tools/build-help-diagrams.ts",
    "help:shots": "bun tools/capture-help-shots.ts",
    "docs:shots": "bun tools/capture-docs-shots.ts",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "check:static": "bun run lint && bun run lint:css && tsc -p tsconfig.app.json --noEmit",
    "verify:quick": "bun run check:static && bun run test",
    "verify": "bun run check:static && bun run test:coverage && bun run build"
  },
  "private": true,
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@ngrx-toolkit/core": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "angular-oauth2-oidc": "^22.0.2",
    "d3-drag": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "dompurify": "3.4.17",
    "echarts": "^6.1.0",
    "eventsource-parser": "4.1.3",
    "highlight.js": "^11.12.0",
    "lucide": "^1.70.0",
    "marked": "^18.1.3",
    "ngx-vflow": "^2.7.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
