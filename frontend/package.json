{
  "name": "frontend",
  "version": "0.5.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --configuration coverage",
    "test:browser": "ng run frontend:test-browser",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "help:diagrams": "bun tools/build-help-diagrams.ts",
    "help:shots": "bun tools/capture-help-shots.ts",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "check:static": "bun run lint && bun run lint:css && tsc -p tsconfig.app.json --noEmit",
    "verify:quick": "bun run check:static && bun run test",
    "verify": "bun run check:static && bun run test:coverage && bun run build"
  },
  "private": true,
  "packageManager": "bun@1.3.12",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^22.0.0",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@ngrx/signals": "^22.0.0",
    "angular-oauth2-oidc": "^22.0.2",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "lucide": "^1.39.0",
    "marked": "^18.0.11",
    "ngx-vflow": "^2.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "daisyui": "^5.7.24",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  }
}
