{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.ico", "/*.png", "/*.css", "/*.js"]
      }
    },
    {
      "name": "i18n",
      "installMode": "prefetch",
      "resources": {
        "files": ["/i18n/*.json"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/*.woff2"]
      }
    },
    {
      "name": "help",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/help/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
