# Copy to .env — .env is gitignored.

# --- Mail access ----------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Mode A: filter the newsletter out of a mixed folder
NEWSLETTER_FOLDER=INBOX
NEWSLETTER_FROM=
NEWSLETTER_SUBJECT=
# CSS selector for one offer block; set after inspecting real mails
NEWSLETTER_BLOCK_SELECTOR=

# --- Language model -------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_EXTRACTION=claude-haiku-4-5   # small model
LLM_MODEL_SCORING=claude-sonnet-4-5     # large model
LLM_MODEL_WRITING=claude-sonnet-4-5
LLM_MODEL_EMBEDDING=

# --- Database -------------------------------------------------------------
# Host and port apply to a local run; inside Compose the api service overrides
# them with the service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=

# --- Digest ---------------------------------------------------------------
DIGEST_CHANNEL=email
DIGEST_TO=
STRAIGHTMAIL_URL=

# --- Ports ----------------------------------------------------------------
SERVER_PORT=8080
WEB_PORT=4200
# The dev server proxies /api here; without it localhost:8080 applies.
API_PROXY_TARGET=http://localhost:8080

# --- Misc -----------------------------------------------------------------
# Everything individual lives below this directory and is gitignored.
LEADGEN_CONFIG_DIR=./config/local
PACKAGES_DIR=./packages
INBOX_DIR=./data/inbox
AUTH_MODE=none
LOG_LEVEL=INFO
