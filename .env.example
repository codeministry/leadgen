# Copy to .env — .env is gitignored.

# --- Mail access ----------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# The IMAP keyword this instance writes on every mail it takes, and the whole of its progress.
# Two instances reading one mailbox (a laptop and a server, say) need two names, or whichever
# searches first takes the mail and the other never sees it. A new name re-reads the folder once.
IMAP_PROGRESS_FLAG=leadgen

# Mode A: filter the newsletter out of a mixed folder
NEWSLETTER_FOLDER=INBOX
NEWSLETTER_FROM=
NEWSLETTER_SUBJECT=
# CSS selector for one offer block; set after inspecting real mails
NEWSLETTER_BLOCK_SELECTOR=

# --- Language model -------------------------------------------------------
# Optional in full. Without a key the tool runs and only loses scoring and the
# cover letter; the filtering that removes 80.9 % of the offers is deterministic.
# The provider names a wire format, not a vendor. `anthropic` is the Messages API,
# `openai-compatible` and `ollama` the chat-completions one that most other services
# speak. Which host answers is LLM_BASE_URL and nothing else, so a provider's own
# address belongs here rather than in a committed file.
LLM_PROVIDER=                           # anthropic | ollama | openai-compatible
LLM_BASE_URL=                           # e.g. http://localhost:11434/v1 for a local Ollama
LLM_API_KEY=
LLM_BATCH=                              # true halves the price and makes scoring asynchronous
LLM_TIMEOUT=                            # ISO-8601, e.g. PT120S. One request to a model; empty is PT120S
LLM_CONCURRENCY=                        # adverts the model-bound stages work at once; empty is 1, at most the DB pool (10)
LLM_MODEL_EXTRACTION=                   # reads a document a source's rules could not; empty falls back to SCORING
LLM_MODEL_CONTENT=                      # labels an advert's blocks; empty means LLM_MODEL_SCORING
LLM_MODEL_FIELDS=                       # reads start, duration, apply-by; empty means LLM_MODEL_SCORING
LLM_MODEL_SCORING=                      # the judge, and the default of the list below
# Comma separated. What the select beside the run button offers, and an allowlist:
# nothing outside it can be requested. LLM_MODEL_SCORING is always offered.
LLM_MODEL_SCORING_OPTIONS=
LLM_MODEL_WRITING=                      # cover letters
LLM_MODEL_EMBEDDING=                    # >= 2000 dims, for deduplication's similarity strategies

# The retrieval index: one vector per offer over the whole de-furnitured advert, which is what a
# semantic search reads. Off unless this says true, and a separate switch from the key above on
# purpose — configuring an embedding model for deduplication, where the bands are measured, must
# not silently switch on an indexing pass that has no measured band behind it. The first run
# after switching it on walks the whole working list and may take several nights to clear.
RETRIEVAL_ENABLED=                      # true switches the retrieval index on; empty is off
# The similarity, between 0 and 1, at which a profile topic's name counts as naming an advert in
# the shortlist's topic filter. Leave it unset until it is measured with
# docs/samples/measure_topic_floor.ts: unset, the filter reads the stored alias matches alone.
RETRIEVAL_TOPIC_FLOOR=

# --- Enrichment -----------------------------------------------------------
FETCH_CONCURRENCY=                      # fetches ENRICH has in flight at once; empty is 1. The rate window still bounds the volume

# --- Database -------------------------------------------------------------
# Host and port apply to a local run; inside Compose the api service overrides
# them with the service name. The host port is deliberately not 5432: a developer
# machine usually already has a Postgres there, and connecting to the wrong one
# fails as "password authentication failed", which names neither the host nor the
# database it actually reached.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=

# --- Digest ---------------------------------------------------------------
# A rendered file, not a message. The application never sends anything.
DIGEST_FORMAT=html
DIGEST_DIR=./packages/digest

# --- Ports ----------------------------------------------------------------
SERVER_PORT=8080
WEB_PORT=4200
# The dev server proxies /api here; without it localhost:8080 applies.
API_PROXY_TARGET=http://localhost:8080

# --- Misc -----------------------------------------------------------------
# Everything individual lives below this directory and is gitignored.
LEADGEN_CONFIG_DIR=./config
# The host directory Compose mounts read-only at /config in the api container; empty is
# ./config. (docker-compose.demo.yml does not read it: the override replaces the mount
# with ./demo outright.)
LEADGEN_CONFIG_MOUNT=./config
PACKAGES_DIR=./packages
INBOX_DIR=./data/inbox
# Where an upload lands. Its default is a path INSIDE the configuration directory, which
# in the container is mounted read-only -- so under Compose it has to be named, or every
# upload fails with a permission error naming a path nobody configured.
MANUAL_INBOX_DIR=./data/inbox
# `none` or `oidc`, and anything else is fatal at load rather than ignored: somebody
# writing `basic` and believing the write endpoints are protected is the worst failure
# available here. Under `none` what stands in front of them is SERVER_ADDRESS below.
# Under `oidc` every request carries a bearer token, OIDC_ISSUER is required, and the
# mode is read once at startup — changing it takes a restart, not a config reload.
AUTH_MODE=none
LOG_LEVEL=INFO

# --- Rarely changed, and listed so they are not invisible ------------------
# Every one of these is named by a ${...} in application.yaml, in one of the shipped
# leadgen/*.yaml files or in docker-compose.yml, or by process.env in the dev server's
# proxy.conf.js. A key that is used and undocumented is a setting nobody knows they have;
# EnvExampleTest holds that in both directions.
#
# Loopback by default, which is the only thing standing in front of the write endpoints
# while AUTH_MODE is `none`. Compose overrides it to 0.0.0.0, because a process bound to
# loopback inside a container is reachable through nothing at all.
SERVER_ADDRESS=127.0.0.1
# The host side of the ports Compose publishes, for both the api and the web container --
# nginx proxies /api/ to the api, so opening one of the two opens both. Loopback by
# default. Setting it to 0.0.0.0 puts the instance on the network, which is the decision
# that needs AUTH_MODE=oidc first.
SERVER_BIND=127.0.0.1
# Says that something outside this process limits who reaches the port, which is what
# lets AUTH_MODE=none live with a bind past loopback. Without it that combination is
# refused at startup rather than served. Compose sets it, because a container has to bind
# every interface and only the host side above decides who arrives. Set it by hand and
# you are asserting the same thing about your own deployment.
ALLOW_OPEN_BIND=false
# What the header reports about the running build. Left unset every image says 0.5.0: the
# Gradle version is not injected into the jar and the Dockerfile copies libs/*.jar by glob,
# so nothing else carries it. The Helm chart sets this from the image tag, which is the one
# thing worth reading off a running pod.
LEADGEN_VERSION=
# File NAMES, resolved against LEADGEN_CONFIG_DIR. A path with a directory baked in breaks
# the moment it moves: in the container that directory is /config.
PROFILE_PATH=skill-profile.yaml
RULES_PATH=matching-rules.yaml
# How often the four configuration files are checked for changes. A change is applied one
# cycle after it is first seen, so a save in progress finishes first — worst case is twice
# this value.
CONFIG_POLL_INTERVAL=PT2S
# How often a submitted scoring batch is asked whether it has ended. Only read when
# LLM_BATCH is true.
SCORE_BATCH_POLL_INTERVAL=PT5M
# When the tool starts a pass by itself, as a Spring cron expression in the JVM's
# timezone: second minute hour day month weekday. `-` means no schedule at all, which is
# the default, and it is how the container ships. `0 0 6 * * *` is six every morning.
# A deployment that schedules the run from outside, with a Kubernetes CronJob or with
# cron on the host, leaves this alone.
INGEST_CRON=-
# The feed URL of the `sample-portal-feed` source, which ships disabled.
SAMPLE_FEED_URL=
# Read only when AUTH_MODE is `oidc`, which is not implemented. Here so the schema is not
# a secret; setting them changes nothing today.
OIDC_ISSUER=
OIDC_CLIENT_ID=
